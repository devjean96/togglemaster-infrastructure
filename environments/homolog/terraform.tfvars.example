academy_mode = true
lab_role_arn = "arn:aws:iam::123456789012:role/LabRole"

# Par de versoes compativel: ArgoCD 3.5.2 inclui schemas do Kubernetes 1.36.
kubernetes_version      = "1.36"
argocd_chart_version    = "10.4.1"

# Restrinja ao CIDR publico da equipe sempre que possivel.
eks_public_access_cidrs = ["203.0.113.10/32"]

# Passe senhas e chaves via TF_VAR_*; nao grave segredos neste arquivo.
# TF_VAR_auth_master_key e TF_VAR_evaluation_service_api_key devem possuir
# pelo menos 32 caracteres.

# O Terraform instala o ArgoCD e cria a root Application que observa este repositorio.
argocd_bootstrap_gitops = true
gitops_repository_url  = "https://github.com/devjean96/togglemaster-gitops.git"
